	<item>
		<title><![CDATA[ホーム]]></title>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<content:encoded><![CDATA[<!-- wp:group {"tagName":"section","align":"full","className":"hero","layout":{"type":"constrained"}} -->
<section class="wp-block-group alignfull hero"><!-- wp:group {"className":"hero-in","layout":{"type":"default"}} -->
<div class="wp-block-group hero-in"><!-- wp:group {"className":"hero-text","layout":{"type":"default"}} -->
<div class="wp-block-group hero-text"><!-- wp:heading {"level":1,"className":"hero-title"} -->
<h1 class="wp-block-heading hero-title">歯を残すことを、<br>いちばん先に考える。</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"hero-lead"} -->
<p class="hero-lead">みずき台駅から徒歩3分の歯科医院です。削る量と治療の回数を先にお伝えしてから始めます。一般歯科・小児歯科・矯正歯科に対応しています。</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="first/">初めての方へ</a></div>
<!-- /wp:button --><!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="treatment/">診療案内</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:group -->

<!-- wp:group {"className":"hero-art","layout":{"type":"default"}} -->
<div class="wp-block-group hero-art"><!-- wp:heading {"className":"hours-title"} -->
<h2 class="wp-block-heading hours-title">診療時間</h2>
<!-- /wp:heading -->

<!-- wp:block {"ref":130} /--></div>
<!-- /wp:group --></div>
<!-- /wp:group --></section>
<!-- /wp:group -->

<!-- wp:group {"tagName":"section","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|section","bottom":"var:preset|spacing|section"}}},"layout":{"type":"constrained"}} -->
<section class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--section);padding-bottom:var(--wp--preset--spacing--section)"><!-- wp:group {"className":"sec-head","layout":{"type":"default"}} -->
<div class="wp-block-group sec-head"><!-- wp:paragraph {"className":"is-style-eyebrow"} -->
<p class="is-style-eyebrow">TREATMENT</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">診療案内</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"sec-lead"} -->
<p class="sec-lead">むし歯や歯周病の治療から、予防、矯正、自由診療まで対応しています。</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"className":"cards","layout":{"type":"default"}} -->
<div class="wp-block-group cards"><!-- wp:group {"className":"is-style-card ico-general","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-card ico-general"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">一般歯科</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>むし歯と歯周病の治療です。痛みや腫れの原因を確かめたうえで、削る範囲と回数の見通しをお伝えしてから始めます。</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"more"} -->
<p class="more"><a href="treatment/#general">くわしく</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"is-style-card ico-child","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-card ico-child"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">小児歯科</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>お子さまの歯の治療と予防です。初回は器具に触れて慣れるところから始め、そのお子さまの様子に合わせて進めます。</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"more"} -->
<p class="more"><a href="treatment/#child">くわしく</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"is-style-card ico-ortho","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-card ico-ortho"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">矯正歯科</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>歯並びとかみ合わせの治療です。装置の種類ごとに、期間・通院回数・費用・想定される負担を先にご説明します。</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"more"} -->
<p class="more"><a href="treatment/#ortho">くわしく</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"is-style-card ico-prevent","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-card ico-prevent"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">予防歯科</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>治療が終わったあとの状態を保つための定期検診とクリーニングです。次のご来院までの間隔は口の状態に応じて決めます。</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"more"} -->
<p class="more"><a href="treatment/#prevent">くわしく</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"is-style-card ico-white","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-card ico-white"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">ホワイトニング</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>薬剤で歯の色調を明るくする自由診療です。効果の出方には個人差があり、知覚過敏が生じる場合があります。</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"more"} -->
<p class="more"><a href="treatment/#white">くわしく</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"is-style-card ico-implant","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-card ico-implant"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">インプラント</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>歯を失った部分に人工歯根を埋め込む自由診療です。骨の状態によっては適応とならないことがあります。</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"more"} -->
<p class="more"><a href="treatment/#implant">くわしく</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --></div>
<!-- /wp:group --></section>
<!-- /wp:group -->

<!-- wp:group {"tagName":"section","align":"full","backgroundColor":"surface","style":{"spacing":{"padding":{"top":"var:preset|spacing|section","bottom":"var:preset|spacing|section"}}},"layout":{"type":"constrained"}} -->
<section class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--section);padding-bottom:var(--wp--preset--spacing--section)"><!-- wp:group {"className":"sec-head","layout":{"type":"default"}} -->
<div class="wp-block-group sec-head"><!-- wp:paragraph {"className":"is-style-eyebrow"} -->
<p class="is-style-eyebrow">POLICY</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">診療の進め方</h2>
<!-- /wp:heading --></div>
<!-- /wp:group -->

<!-- wp:group {"className":"is-style-flow","layout":{"type":"default"}} -->
<div class="wp-block-group is-style-flow"><!-- wp:group {"className":"step","layout":{"type":"default"}} -->
<div class="wp-block-group step"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">検査して、今の状態をお見せする</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>レントゲンと口腔内カメラで撮影し、モニタでご覧いただきながらご説明します。</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"step","layout":{"type":"default"}} -->
<div class="wp-block-group step"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">治療の選択肢と費用をお伝えする</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>保険診療で行える方法と、自由診療の方法を並べてお示しします。回数と期間の見通しもあわせてお伝えします。</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"step","layout":{"type":"default"}} -->
<div class="wp-block-group step"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">ご同意のうえで治療を始める</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>その日に決めていただく必要はありません。持ち帰ってご検討いただけます。</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --><!-- wp:group {"className":"step","layout":{"type":"default"}} -->
<div class="wp-block-group step"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">治療後の状態を保つ</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>治療が終わったあとは、3〜6か月ごとの定期検診で状態を確認します。</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --></div>
<!-- /wp:group --></section>
<!-- /wp:group -->]]></content:encoded>
