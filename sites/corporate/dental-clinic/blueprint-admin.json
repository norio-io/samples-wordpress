{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "みずき歯科クリニック（管理画面）",
    "description": "架空の歯科医院のコーポレートサイト。自作ブロックテーマの制作サンプル。",
    "author": "norio-io",
    "categories": [
      "Theme"
    ]
  },
  "landingPage": "/wp-admin/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "ja"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/norio-io/samples-wordpress",
        "ref": "main",
        "refType": "branch",
        "path": "sites/corporate/dental-clinic/theme"
      },
      "options": {
        "activate": true,
        "targetFolderName": "mizuki-dental"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\n// 初期状態の投稿・固定ページを削除する。お知らせの一覧に混ざらないようにするため。\nforeach ( array( 1, 2, 3 ) as $id ) {\n\twp_delete_post( $id, true );\n}\n"
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/norio-io/samples-wordpress/main/sites/corporate/dental-clinic/content/demo.xml"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "みずき歯科クリニック",
        "blogdescription": "杉並区みずき台の歯科医院",
        "show_on_front": "page",
        "page_on_front": 110,
        "page_for_posts": 116,
        "timezone_string": "Asia/Tokyo",
        "date_format": "Y.m.d",
        "permalink_structure": "/news/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\n// 書き換え規則を作り直す。パーマリンクは直前の手順で「お知らせ（/news/）の配下の投稿名」とした。静的版と URL の階層を揃えるため。\n// カテゴリーの規則はパーマリンクの接頭辞（/news/）を含めて登録されるため、パーマリンクを変更した要求とは別の要求で作り直す。\nflush_rewrite_rules();\n"
    }
  ]
}
