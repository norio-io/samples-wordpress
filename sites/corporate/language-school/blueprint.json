{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "ひびき英語スクール",
    "description": "架空の語学スクールのサイト。自作ブロックテーマの制作サンプル。",
    "author": "norio-io",
    "categories": [
      "Theme"
    ]
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "ja"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/norio-io/samples-wordpress",
        "ref": "main",
        "refType": "branch",
        "path": "sites/corporate/language-school/theme"
      },
      "options": {
        "activate": true,
        "targetFolderName": "hibiki-english"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\n// 初期状態の投稿・固定ページを削除する。\nforeach ( array( 1, 2, 3 ) as $id ) {\n\twp_delete_post( $id, true );\n}\n"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "ひびき英語スクール",
        "blogdescription": "千景市の英会話・英語スクール",
        "timezone_string": "Asia/Tokyo",
        "date_format": "Y.m.d",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/norio-io/samples-wordpress/main/sites/corporate/language-school/content/demo.xml"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\n// 書き換え規則を作り直す。コース（/courses/）・講師（/instructors/）・対象（/target/）の規則を含めるため、テーマを有効にした後の要求で行う。\nflush_rewrite_rules();\n"
    }
  ]
}
